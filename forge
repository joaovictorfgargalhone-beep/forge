			fi

			{
				echo "NAME=\"${PACKAGE}\""
				echo "VERSION=\"${SK_VERSION}\""
				echo "URL=\"${SKETCH_URL}\""
				echo "PKG_FORMAT=\"${SKETCH_PKG_FORMAT}\""
				echo ""
				echo "# PKG_FORMAT recipes install a ready-made binary package"
				echo "# directly -- no heat()/mold()/smith() needed or called."
			} > "$RECIPE_TARGET"
			echo ""
			echo "Recipe generated at: $RECIPE_TARGET"
			echo "Review it and run 'forge assay $PACKAGE' before smithing."
			exit 0
		fi

		SKETCH_IS_GIT=0
		[ "$SKETCH_BOOK" = "git" ] && SKETCH_IS_GIT=1

		PAGE_HTML=""
		SK_DL_HTML=""
		SK_DL_BASE_URL=""
		SK_PATCH_EXTRA_HTML=""
		SK_DL_MAIN_URL=""

		if [ "$SKETCH_IS_GIT" -eq 1 ]; then
			echo "Cloning $SKETCH_URL to inspect it${SKETCH_REF:+ (ref: $SKETCH_REF)}..."
			SK_GIT_RESULT=$(sketch_git_lookup "$SKETCH_URL" "$SKETCH_REF")
			if [ -z "$SK_GIT_RESULT" ]; then
				echo "Error: couldn't clone '$SKETCH_URL'${SKETCH_REF:+ at ref '$SKETCH_REF'} -- check the URL/ref."
				exit 1
			fi
			SK_GIT_CLONE_DIR=""
			IFS=$'\t' read -r SK_VERSION SK_GIT_REF_RESOLVED SK_GIT_CLONE_DIR <<< "$SK_GIT_RESULT"
			echo "Resolved to ref '$SK_GIT_REF_RESOLVED' (version: $SK_VERSION)"

			SK_DETECTED_BUILD=$(sketch_detect_build_system_dir "$SK_GIT_CLONE_DIR")
			if [ -n "$SK_DETECTED_BUILD" ]; then
				echo "Detected a $SK_DETECTED_BUILD build in the repo -- generating generic heat()/mold()/smith() (REVIEW these, they're a generic guess, not scraped from documentation)."
				sketch_generic_build_commands "$SK_DETECTED_BUILD"
			else
				echo "Warning: no recognizable build system (meson.build/configure/autogen.sh/setup.py) found in the repo. heat()/mold()/smith() are left as TODO."
				SK_HEAT_BODY="# TODO: no recognizable build system found in the repo."
				SK_MOLD_BODY="# TODO: no build command automatically found in the repo."
				SK_SMITH_BODY="# TODO: no install command automatically found in the repo."
			fi
			rm -rf "$SK_GIT_CLONE_DIR"
		elif [ "$SKETCH_IS_TARBALL" -eq 1 ]; then
			echo "'--url' points straight at a tarball -- skipping page scraping. Deriving version from the filename and detecting the build system from the archive itself."
			PAGE_HTML=""
			SK_DL_HTML=""
			SK_DL_BASE_URL="$SKETCH_URL"
			SK_PATCH_EXTRA_HTML=""
			SK_METADATA=$(sketch_parse_tarball_url "$SKETCH_URL")
			if [ -z "$SK_METADATA" ]; then
				echo "Error: couldn't find a '-<version>' suffix in '$SKETCH_URL' (expected something like pkgname-1.2.3.tar.xz)."
				exit 1
			fi
		else
			echo "Downloading page: $SKETCH_URL"
			PAGE_HTML=$(wget -qO- "$SKETCH_URL")
			if [ -z "$PAGE_HTML" ]; then
				echo "Error: failed to download $SKETCH_URL"
				exit 1
			fi

			# LFS build pages don't carry their own Download/checksum info --
			# see sketch_find_lfs_download_section. Fetch the two chapter 3
			# pages once and pull out this package's section from each, to
			# use as a fallback wherever the build page itself comes up
			# empty. SK_DL_HTML feeds metadata/additional-downloads
			# extraction; SK_PATCH_EXTRA_HTML is appended alongside PAGE_HTML
			# for patch-link extraction (patches can be listed on either
			# page depending on the package).
			SK_DL_HTML="$PAGE_HTML"
			SK_DL_BASE_URL="$SKETCH_URL"
			SK_PATCH_EXTRA_HTML=""
			if [ "$SKETCH_BOOK" = "lfs" ]; then
				if ! printf '%s' "$PAGE_HTML" | grep -qiP 'Download\s*\(HTTP\)'; then
					echo "LFS build page has no download link -- checking chapter 3 (Packages) for it..."
					SK_LFS_PACKAGES_HTML=$(wget -qO- "$LFS_PACKAGES_PAGE_URL")
					if [ -n "$SK_LFS_PACKAGES_HTML" ]; then
						SK_LFS_DL_SECTION=$(sketch_find_lfs_download_section "$SK_LFS_PACKAGES_HTML" "$PACKAGE")
						if [ -n "$SK_LFS_DL_SECTION" ]; then
							SK_DL_HTML="$SK_LFS_DL_SECTION"
							SK_DL_BASE_URL="$LFS_PACKAGES_PAGE_URL"
						else
							echo "Warning: '$PACKAGE' not found on the chapter 3 Packages page either -- download/checksum will be left as TODO."
						fi
					else
						echo "Warning: failed to download $LFS_PACKAGES_PAGE_URL"
					fi
				fi
				SK_LFS_PATCHES_HTML=$(wget -qO- "$LFS_PATCHES_PAGE_URL")
				if [ -n "$SK_LFS_PATCHES_HTML" ]; then
					SK_PATCH_EXTRA_HTML=$(sketch_find_lfs_download_section "$SK_LFS_PATCHES_HTML" "$PACKAGE")
				fi
			fi

			SK_MULTI_CATEGORY="${SKETCH_CATEGORY:-$PACKAGE}"
			SK_MULTI_COUNT=0
			SK_MULTI_SKIPPED=0
			while IFS= read -r -d '' SK_SECTION_HTML; do
				SK_MULTI_COUNT=$((SK_MULTI_COUNT + 1))
				sketch_generate_one "$SK_SECTION_HTML" "$SKETCH_URL" "$SK_MULTI_CATEGORY" "$SKETCH_FORCE" \
					|| SK_MULTI_SKIPPED=$((SK_MULTI_SKIPPED + 1))
			done < <(sketch_split_multi_page "$PAGE_HTML")

			if [ "$SK_MULTI_COUNT" -gt 0 ]; then
				echo ""
				echo "Multi-package page detected ($SK_MULTI_COUNT packages found on this one page)."
				echo "Recipes written to: ${RECIPE_DIR}/${SK_MULTI_CATEGORY}/"
				[ "$SK_MULTI_SKIPPED" -gt 0 ] && echo "$SK_MULTI_SKIPPED already existed and were skipped (use --force to overwrite)."
				echo "These are drafts like any other 'forge sketch' output -- review before smithing."
				exit 0
			fi

			if [ "$SKETCH_BOOK" = "gnome" ]; then
				SK_METADATA="$SK_GNOME_METADATA"
			else
				SK_METADATA=$(sketch_extract_metadata "$SK_DL_HTML")
			fi
			if [ -z "$SK_METADATA" ]; then
				echo "Error: couldn't identify a tarball/version link on that page."
				if [ "$SKETCH_BOOK" = "lfs" ]; then
					echo "Checked both the build page and the chapter 3 Packages page. Check manually: $SKETCH_URL and $LFS_PACKAGES_PAGE_URL"
				else
					echo "The page might not follow the book's standard format. Check it manually: $SKETCH_URL"
				fi
				exit 1
			fi
		fi
		if [ "$SKETCH_IS_GIT" -ne 1 ]; then
			IFS=$'\t' read -r SK_URL_TEMPLATE SK_VERSION SK_ALGO SK_CHECKSUM <<< "$SK_METADATA"
			SK_DL_MAIN_URL="${SK_URL_TEMPLATE//\$\{VERSION\}/$SK_VERSION}"
		fi

		if [ "$SKETCH_IS_GIT" -ne 1 ]; then
			SK_HEAT_BODY=""
			SK_MOLD_BODY=""
			SK_SMITH_BODY=""
			SK_FINISH_BODY=""
			while IFS=$'\t' read -r SK_TAG SK_BLOCK; do
				[ -z "$SK_TAG" ] && continue
				SK_REAL_BLOCK=$(printf '%b' "$SK_BLOCK")
				if [[ "$SK_TAG" == *O ]]; then
					SK_REAL_BLOCK="# OPTIONAL per the book (verify whether you want this) -->"$'\n'"${SK_REAL_BLOCK}"
					SK_TAG="${SK_TAG%O}"
				fi
				case "$SK_TAG" in
					F) SK_FINISH_BODY+="${SK_REAL_BLOCK}"$'\n' ;;
					R) SK_SMITH_BODY+="${SK_REAL_BLOCK}"$'\n' ;;
					*) SK_MOLD_BODY+="${SK_REAL_BLOCK}"$'\n' ;;
				esac
			done < <(sketch_extract_blocks "$PAGE_HTML")

			if [ -z "$SK_SMITH_BODY" ] && [ -n "$SK_MOLD_BODY" ]; then
				SK_LAST_LINE=$(printf '%s\n' "$SK_MOLD_BODY" | grep -E '(make|ninja|meson).*install' | tail -n1)
				if [ -n "$SK_LAST_LINE" ]; then
					SK_MOLD_BODY=$(printf '%s\n' "$SK_MOLD_BODY" | grep -vF "$SK_LAST_LINE")
					SK_SMITH_BODY="${SK_LAST_LINE}"$'\n'
				fi
			fi

			if [ -n "$SK_MOLD_BODY" ]; then
				sketch_split_heat_mold "$SK_MOLD_BODY"
			fi

			if [ -z "$SK_HEAT_BODY" ] && [ -z "$SK_MOLD_BODY" ] && [ -z "$SK_SMITH_BODY" ]; then
				echo "No command blocks found${SKETCH_BOOK:+ on the $SKETCH_BOOK page} -- checking the tarball itself for a recognizable build system..."
				SK_PEEK_TARBALL="${WORKDIR}/.sketch-peek-$$"
				mkdir -p "$WORKDIR"
				if wget -qO "$SK_PEEK_TARBALL" "$SK_DL_MAIN_URL"; then
					SK_DETECTED_BUILD=$(sketch_detect_build_system "$SK_PEEK_TARBALL")
				else
					SK_DETECTED_BUILD=""
					echo "Warning: couldn't download the tarball to inspect it ($SK_DL_MAIN_URL)."
				fi
				rm -f "$SK_PEEK_TARBALL"

				if [ -n "$SK_DETECTED_BUILD" ]; then
					case "$SK_DETECTED_BUILD" in
						meson)     SK_DETECTED_FILE="meson.build" ;;
						configure) SK_DETECTED_FILE="configure" ;;
						autogen)   SK_DETECTED_FILE="autogen.sh" ;;
						setuppy)   SK_DETECTED_FILE="setup.py" ;;
					esac
					echo "Found a top-level '$SK_DETECTED_FILE' in the tarball -- generating generic heat()/mold()/smith() (REVIEW these, they're a generic guess, not scraped from documentation)."
					sketch_generic_build_commands "$SK_DETECTED_BUILD"
				else
					echo "Warning: no recognizable build system (meson.build/configure/autogen.sh/setup.py) found in the tarball either. heat()/mold()/smith() are left as TODO."
					SK_HEAT_BODY="# TODO: no configuration command was automatically found on the book page or detected in the tarball."
					SK_MOLD_BODY="# TODO: no build command was automatically found on the book page or detected in the tarball."
					SK_SMITH_BODY="# TODO: no install command was automatically found on the book page or detected in the tarball."
				fi
			fi
		fi

		# A page/tarball can genuinely have build+install commands but no
		# separate configuration step at all (setup.py-based Python
		# packages, header-only projects, anything that skipped straight
		# to make/ninja in its own docs) -- per the "always define heat()"
		# convention, note that explicitly instead of leaving it out.
		if [ -z "$SK_HEAT_BODY" ]; then
			SK_HEAT_BODY="echo 'No configuration for this package'"$'\n'
		fi

		# Fix up heredocs (<<EOF -> <<-EOF) so the closing delimiter
		# survives being tab-indented below -- plain "<<" requires the
		# delimiter at column 0, "<<-" strips leading tabs from it.
		SK_HEREDOC_FIX='s/<<[[:space:]]*("|'"'"')?([A-Za-z_][A-Za-z0-9_]*)\1/<<-\1\2\1/'
		SK_HEAT_BODY=$(printf '%s\n' "$SK_HEAT_BODY" | sed -E "$SK_HEREDOC_FIX")
		SK_MOLD_BODY=$(printf '%s\n' "$SK_MOLD_BODY" | sed -E "$SK_HEREDOC_FIX")
		SK_SMITH_BODY=$(printf '%s\n' "$SK_SMITH_BODY" | sed -E "$SK_HEREDOC_FIX")
		SK_FINISH_BODY=$(printf '%s\n' "$SK_FINISH_BODY" | sed -E "$SK_HEREDOC_FIX")

		SK_BUILD_DIR=$(sketch_detect_build_dir "$SK_MOLD_BODY")
		if [ -n "$SK_BUILD_DIR" ]; then
			SK_SMITH_BODY="cd \"${SK_BUILD_DIR}\"  # mold() builds here; smith() starts fresh in \$SRC_DIR"$'\n'"${SK_SMITH_BODY}"
		fi

		SK_SMITH_BODY=$(printf '%s\n' "$SK_SMITH_BODY" \
			| sed -e '/DESTDIR/!s/\(make[^&|;]*\)install\b/\1DESTDIR="$1" install/' \
			      -e '/DESTDIR/!s/\(ninja[^&|;]*\)install\b/DESTDIR="$1" \1install/')
		SK_SMITH_BODY=$(printf '%s\n' "$SK_SMITH_BODY" | while IFS= read -r SK_LINE; do
			if printf '%s' "$SK_LINE" | grep -qE '(/usr/|/etc/|/var/|/opt/)' \
				&& ! printf '%s' "$SK_LINE" | grep -qE 'DESTDIR|\$1'; then
				printf '%s  # TODO: references an absolute path -- check whether it needs to be prefixed with "$1"\n' "$SK_LINE"
			else
				printf '%s\n' "$SK_LINE"
			fi
		done)

		SK_DEPS_HINT=""
		SK_DEPS_SECTION=$(printf '%s' "$PAGE_HTML" | grep -ozP '(?is)Required[^<]*</[^>]+>.*?</ul>' | tr -d '\0' | head -c 3000)
		if [ -n "$SK_DEPS_SECTION" ]; then
			SK_DEPS_HINT=$(printf '%s' "$SK_DEPS_SECTION" | grep -oP '(?<=>)[A-Za-z0-9][A-Za-z0-9+._-]*(?=</a>)' | sort -u | tr '\n' ',' | sed 's/,$//; s/,/, /g')
		fi

		SK_PATCHES=()
		while IFS= read -r SK_PATCH_URL; do
			[ -z "$SK_PATCH_URL" ] && continue
			SK_PATCHES+=("$SK_PATCH_URL")
		done < <(
			{
				sketch_extract_patches "$PAGE_HTML" "$SKETCH_URL"
				[ -n "$SK_PATCH_EXTRA_HTML" ] && sketch_extract_patches "$SK_PATCH_EXTRA_HTML" "$LFS_PATCHES_PAGE_URL"
			} | sort -u
		)

		SK_ADDITIONAL_LINES=""
		while IFS=$'\t' read -r SK_DL_URL SK_DL_OPTIONAL; do
			[ -z "$SK_DL_URL" ] && continue
			if [ "$SK_DL_OPTIONAL" = "1" ]; then
				SK_ADDITIONAL_LINES+="# OPTIONAL per the book:"$'\n'"# wget \"${SK_DL_URL}\""$'\n'
			else
				SK_ADDITIONAL_LINES+="wget \"${SK_DL_URL}\"  # TODO: additional download found on the book page -- verify it's needed and add a checksum check if so"$'\n'
			fi
		done < <(sketch_extract_additional_downloads "$SK_DL_HTML" "$SK_DL_BASE_URL" "$SK_DL_MAIN_URL")
		if [ -n "$SK_ADDITIONAL_LINES" ]; then
			SK_MOLD_BODY="${SK_ADDITIONAL_LINES}${SK_MOLD_BODY}"
		fi

		mkdir -p "$(dirname "$RECIPE_TARGET")"
		{
			echo "# Auto-generated by 'forge sketch' from:"
			echo "#   $SKETCH_URL"
			echo "# REVIEW before using: check configure/meson/cmake flags, the DEPS array,"
			echo "# and whether smith() really installs into \"\$1\" (staging), not the real system."
			[ -n "$SK_DEPS_HINT" ] && echo "# Dependencies mentioned in the book (add to the DEPS array manually): $SK_DEPS_HINT"
			if [ ${#SK_PATCHES[@]} -gt 0 ]; then
				echo "# Patch link(s) found on the page -- REVIEW: these rarely list a checksum"
				echo "# next to them the way the main tarball does, so none is set below. Add"
				echo "# one manually (url::sha256sum) once you've verified the patch, and apply"
				echo "# it in mold() the way the book shows (patches land in \"\$WORKDIR\", a"
				echo "# sibling of the extracted source tree, so 'patch -Np1 -i ../foo.patch'"
				echo "# from inside mold() works as-is)."
			fi
			echo ""
			echo "NAME=\"${PACKAGE}\""
			echo "VERSION=\"${SK_VERSION}\""
			if [ "$SKETCH_IS_GIT" -eq 1 ]; then
				echo "GIT_URL=\"${SKETCH_URL}\""
				echo "GIT_REF=\"${SK_GIT_REF_RESOLVED}\"  # pin this -- an unpinned branch means every future 'smith' could pull something different"
			else
				echo "URL=\"${SK_URL_TEMPLATE}\""
				if [ "$SK_ALGO" = "sha256" ] && [ -n "$SK_CHECKSUM" ]; then
					echo "SHA256SUM=\"${SK_CHECKSUM}\""
				elif [ "$SK_ALGO" = "md5" ] && [ -n "$SK_CHECKSUM" ]; then
					echo "MD5SUM=\"${SK_CHECKSUM}\""
				else
					echo "# TODO: no checksum was automatically found on the page; add SHA256SUM or MD5SUM."
				fi
			fi
			if [ ${#SK_PATCHES[@]} -gt 0 ]; then
				echo "EXTRA_FILES=("
				for SK_PATCH_URL in "${SK_PATCHES[@]}"; do
					echo "	\"${SK_PATCH_URL}\"  # TODO: add ::sha256sum after verifying"
				done
				echo ")"
			fi
			echo ""
			echo "heat() {"
			printf '%s\n' "$SK_HEAT_BODY" | sed '/^[[:space:]]*$/d; s/^/\t/'
			echo "}"
			echo ""
			echo "mold() {"
			printf '%s\n' "$SK_MOLD_BODY" | sed '/^[[:space:]]*$/d; s/^/\t/'
			echo "}"
			echo ""
			echo "smith() {"
			printf '%s\n' "$SK_SMITH_BODY" | sed '/^[[:space:]]*$/d; s/^/\t/'
			echo "}"
			if [ -n "$SK_FINISH_BODY" ]; then
				echo ""
				echo "# From a 'Configuring $PACKAGE' section on the book page -- these run"
				echo "# against the REAL installed system (not staging), same as smith()'s"
				echo "# \"\$1\", which is why there's no DESTDIR/\"\$1\" rewriting here."
				echo "finish() {"
				printf '%s\n' "$SK_FINISH_BODY" | sed '/^[[:space:]]*$/d; s/^/\t/'
				echo "}"
			fi
		} > "$RECIPE_TARGET"

		echo ""
		echo "Recipe generated at: $RECIPE_TARGET"
		if [ -n "$SK_FINISH_BODY" ]; then
			echo "Found a 'Configuring' section on the page -- added as finish()."
		fi
		if [ -n "$SK_BUILD_DIR" ]; then
			echo "Detected a build subdirectory ('$SK_BUILD_DIR') -- added a cd at the start of smith()."
		fi
		if [ -n "$SK_ADDITIONAL_LINES" ]; then
			echo "Found additional download(s) beyond the main tarball -- added to mold() (commented out if the page marked them optional)."
		fi
		echo "Review mold()/smith() and run 'forge assay $PACKAGE' before smithing."
		;;
	temper)
		if [ -z "$PACKAGE" ]; then
			echo "Error: Specify the package to update, e.g. 'forge temper foo'"
			exit 1
		fi

		if [ "$PACKAGE" = "--all" ]; then
			echo "Checking all installed packages for updates..."
			TO_UPDATE=()
			UP_TO_DATE=()
			SKIPPED=()

			for MANIFEST_FILE in "$LOG_DIR"/*.files; do
				[ -e "$MANIFEST_FILE" ] || continue
				PKG_NAME=$(basename "$MANIFEST_FILE" .files)
				PKG_RECIPE=$(resolve_recipe "$PKG_NAME")

				if [ $? -ne 0 ] || [ ! -f "$PKG_RECIPE" ]; then
					SKIPPED+=("$PKG_NAME (no recipe found)")
					continue
				fi

				RECIPE_VERSION=$(source "$PKG_RECIPE" >/dev/null 2>&1; echo "${VERSION%$'\r'}")
				INSTALLED_VERSION=$(head -n1 "$MANIFEST_FILE" | sed -n 's/^#VERSION=//p')

				if [ "$INSTALLED_VERSION" = "$RECIPE_VERSION" ]; then
					UP_TO_DATE+=("$PKG_NAME")
				else
					TO_UPDATE+=("$PKG_NAME (${INSTALLED_VERSION:-unknown} -> $RECIPE_VERSION)")
				fi
			done

			if [ ${#TO_UPDATE[@]} -eq 0 ]; then
				echo "All packages are already up to date."
				[ ${#SKIPPED[@]} -gt 0 ] && echo "Skipped: ${SKIPPED[*]}"
				exit 0
			fi
			
			echo ""
			echo "The following package(s) will be tempered:"
			for ENTRY in "${TO_UPDATE[@]}"; do
				echo "	- $ENTRY"
			done
			echo ""

			ALL_FORCE=$3
			if [[ ! "$ALL_FORCE" =~ ^(-y|--yes)$ ]]; then
				read -rp "Proceed with tempering ${#TO_UPDATE[@]} packages(s)? [y/N] " CONFIRM
				case "$CONFIRM" in
					[yY][eE][sS]|[yY]) ;;
					*) echo "Temper --all aborted."; exit 0 ;;
				esac
			fi

			UPDATED=()
			for ENTRY in "${TO_UPDATE[@]}"; do
				PKG_NAME="${ENTRY%% *}"
				echo ""
				echo "=== Tempering $ENTRY ==="
				"$0" smith "$PKG_NAME" -y
				if [ $? -eq 0 ]; then
					UPDATED+=("$PKG_NAME")
				else
					SKIPPED+=("$PKG_NAME (smith failed, see output above)")
				fi
			done

			echo ""
			echo "=== Temper --all summary ==="
			echo "Updated: ${UPDATED[*]:-none}"
			echo "Already up to date: ${UP_TO_DATE[*]:-none}"
			[ ${#SKIPPED[@]} -gt 0 ] && echo "Skipped: ${SKIPPED[*]}"
			exit 0
		fi
		
		RECIPE=$(resolve_recipe "$PACKAGE")
		RESOLVE_STATUS=$?

		if [ "$RESOLVE_STATUS" -eq 2 ]; then
			exit 1
		elif [ "$RESOLVE_STATUS" -ne 0 ] || [ ! -f "$RECIPE" ]; then
			echo "Error: Recipe for '$PACKAGE' not found on $RECIPE_DIR"
			exit 1
		fi

		source "$RECIPE"
		NAME="${NAME%$'\r'}"
		VERSION="${VERSION%$'\r'}"
		CHECKSUM_URL="${CHECKSUM_URL%$'\r'}"
		CHECKSUM_ALGO_HINT="${CHECKSUM_ALGO_HINT%$'\r'}"

		MANIFEST="${LOG_DIR}/${NAME}.files"

		if [ ! -f "$MANIFEST" ]; then
			echo "Package '$NAME' is not installed. Use 'forge smith $NAME' to install it."
			exit 1
		fi

		INSTALLED_VERSION=$(head -n1 "$MANIFEST" | sed -n 's/^#VERSION=//p')

		if [ "$INSTALLED_VERSION" = "$VERSION" ]; then
			echo "Package '$NAME' is already up to date (version $VERSION)."
			exit 0
		fi

		echo "Tempering '$NAME' from ${INSTALLED_VERSION:-unknown} to $VERSION..."

		TEMPER_FORCE=$3
		if [[ ! "$TEMPER_FORCE" =~ ^(-y|--yes)$ ]]; then
			read -rp "Proceed? [y/N] " CONFIRM
			case "$CONFIRM" in
				[yY][eE][sS]|[yY]) ;;
				*) echo "Temper aborted."; exit 0 ;;
			esac
		fi

		if [ -n "$CHECKSUM_URL" ]; then
			echo "Refreshing checksum for '$NAME' $VERSION..."
			fetch_and_save_checksum "$NAME" "$VERSION" "$CHECKSUM_URL" "$CHECKSUM_ALGO_HINT"
		fi

		TEMPER_CLEAN=""
		for ARG in "$@"; do
			{ [ "$ARG" = "--clean" ] || [ "$ARG" = "--fresh" ]; } && TEMPER_CLEAN="$ARG"
		done

		exec "$0" smith "$PACKAGE" -y $TEMPER_CLEAN
		;;
	melt)
		if [ -z "$PACKAGE" ]; then
			echo "Error: Specify the package to melt, e.g. 'forge melt foo'"
			exit 1
		fi

		MELT_WITH_DEPS=0
		MELT_FORCE=0
		for ARG in "$@"; do
			[ "$ARG" = "--with-deps" ] && MELT_WITH_DEPS=1
			{ [ "$ARG" = "-y" ] || [ "$ARG" = "--yes" ] || [ "$ARG" = "-f" ] || [ "$ARG" = "--force" ]; } && MELT_FORCE=1
		done
		FORCE=""
		[ "$MELT_FORCE" -eq 1 ] && FORCE="-y"

		LOCK_FILE="${FORGE_HOME:+$FORGE_HOME/forge.lock}"
		LOCK_FILE="${LOCK_FILE:-/var/lock/forge.lock}"
		mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null
		exec 200>"$LOCK_FILE"
		if ! flock -n 200; then
			echo "Error: existing lock file /var/lock/forge.lock, likely to be by an already existing forge operation, if there's not, remove the lock file and try again."
			exit 1
		fi
				
		MANIFEST="${LOG_DIR}/${PACKAGE}.files"

		if [ ! -f "$MANIFEST" ]; then
			echo "Error: Package '$PACKAGE' does not seem to be installed by forge (manifest not found)."
			exit 1
		fi

		INSTALLED_VERSION=$(head -n1 "$MANIFEST" | sed -n 's/^#VERSION=//p')

		DEPENDENTS=()
		for OTHER_MANIFEST in "$LOG_DIR"/*.files; do
			[ -e "$OTHER_MANIFEST" ] || continue
			OTHER_NAME=$(basename "$OTHER_MANIFEST" .files)
			[ "$OTHER_NAME" = "$PACKAGE" ] && continue

			OTHER_RECIPE=$(resolve_recipe "$OTHER_NAME")
			[ -n "$OTHER_RECIPE" ] && [ -f "$OTHER_RECIPE" ] || continue

			OTHER_DEPS=$(
				DEPS=()
				source "$OTHER_RECIPE" >/dev/null 2>&1
				printf '%s\n' "${DEPS[@]}"
			)
			if printf '%s\n' "$OTHER_DEPS" | grep -qx "$PACKAGE"; then
				DEPENDENTS+=("$OTHER_NAME")
			fi
		done

		if [ ${#DEPENDENTS[@]} -gt 0 ]; then
			echo "Warning: the following installed package(s) depend on '$PACKAGE': ${DEPENDENTS[*]}"
			echo "Removing it may break them."
		fi	
		
		echo "About to melt package: $PACKAGE ${INSTALLED_VERSION:+(version $INSTALLED_VERSION)}"

		if [[ ! "$FORCE" =~ ^(-y|--yes)$ ]]; then
			read -rp "Are you sure you want to remove '$PACKAGE'? [y/N] " CONFIRM
			case "$CONFIRM" in
				[yY][eE][sS]|[yY]) ;;
				*) echo "Melting aborted."; exit 0 ;;
			esac
		fi
				
		echo "Melting the package: $PACKAGE..."
		
		while read -r file; do
			[[ "$file" == \#* ]] && continue
		
			REAL_FILE="${INSTALL_ROOT%/}${file#.}"

			if [ -f "$REAL_FILE" ] || [ -h "$REAL_FILE" ]; then
				rm -v "$REAL_FILE"
			elif [ -d "$REAL_FILE" ]; then
				rmdir "$REAL_FILE" 2>/dev/null && echo "Removed directory '$REAL_FILE'"
			fi
		done < "$MANIFEST"

		rm "$MANIFEST"
		forge_log_history "REMOVE" "$PACKAGE" "$INSTALLED_VERSION"

		echo "Package '$PACKAGE' completely melted from system!"

		if [ "$MELT_WITH_DEPS" -eq 1 ]; then
			ORPHANS_AFTER=$(forge_find_orphans)
			if [ -n "$ORPHANS_AFTER" ]; then
				echo ""
				echo "Now-orphaned dependencies (nothing installed needs them anymore):"
				printf '%s\n' "$ORPHANS_AFTER" | sed 's/^/  /'
				if [[ ! "$FORCE" =~ ^(-y|--yes)$ ]]; then
					read -rp "Remove these too? [y/N] " CONFIRM_ORPHANS
				else
					CONFIRM_ORPHANS="y"
				fi
				case "$CONFIRM_ORPHANS" in
					[yY][eE][sS]|[yY])
						while IFS= read -r ORPHAN_PKG; do
							[ -z "$ORPHAN_PKG" ] && continue
							"$0" melt "$ORPHAN_PKG" -y
						done <<< "$ORPHANS_AFTER"
						;;
					*) echo "Leaving orphaned dependencies in place." ;;
				esac
			fi
		fi
		;;
	orphans)
		echo "Checking for orphaned dependencies..."
		ORPHAN_LIST=$(forge_find_orphans)
		if [ -z "$ORPHAN_LIST" ]; then
			echo "No orphaned dependencies found."
		else
			echo "Installed only as a dependency, and nothing installed needs them anymore:"
			printf '%s\n' "$ORPHAN_LIST" | sed 's/^/  /'
			echo ""
			echo "Remove one:   forge melt <pkg>"
			echo "(Removing whatever originally pulled these in with 'forge melt --with-deps <pkg>' offers to clean these up automatically.)"
		fi
		;;
	search)
		if [ -z "$PACKAGE" ]; then
			echo "Error: Specify a search term, e.g. 'forge search image'"
			exit 1
		fi
		SEARCH_TERM="$PACKAGE"
		SEARCH_HITS=0
		while IFS= read -r RECIPE_FILE; do
			[ -f "$RECIPE_FILE" ] || continue
			SEARCH_NAME=""
			SEARCH_DESC=""
			SEARCH_NAME=$(sed -n 's/^NAME="\?\([^"]*\)"\?.*/\1/p' "$RECIPE_FILE" | head -n1)
			SEARCH_DESC=$(sed -n 's/^DESCRIPTION="\?\([^"]*\)"\?.*/\1/p' "$RECIPE_FILE" | head -n1)
			[ -z "$SEARCH_NAME" ] && SEARCH_NAME=$(basename "$RECIPE_FILE" .sh)
			if printf '%s\n%s\n' "$SEARCH_NAME" "$SEARCH_DESC" | grep -qi -- "$SEARCH_TERM"; then
				SEARCH_HITS=$((SEARCH_HITS + 1))
				SEARCH_STATUS="not installed"
				[ -f "${LOG_DIR}/${SEARCH_NAME}.files" ] && SEARCH_STATUS="installed"
				echo "${SEARCH_NAME} (${SEARCH_STATUS})${SEARCH_DESC:+ -- $SEARCH_DESC}"
			fi
		done < <(find "$RECIPE_DIR" -name '*.sh' 2>/dev/null | sort)
		if [ "$SEARCH_HITS" -eq 0 ]; then
			echo "No recipes matching '$SEARCH_TERM' in $RECIPE_DIR."
			echo "Try 'forge sketch $SEARCH_TERM' to look it up in a book/GNOME/git instead."
		fi
		;;
	patts)
		echo "Available patterns (recipes) in $RECIPE_DIR:"
		while IFS= read -r RECIPE_FILE; do
			[ -e "$RECIPE_FILE" ] || continue
			PKG_NAME=$(basename "$RECIPE_FILE" .sh)
			PKG_VERSION=$(source "$RECIPE_FILE" >/dev/null 2>&1; echo "${VERSION%$'\r'}")

			if [ -f "${LOG_DIR}/${PKG_NAME}.files" ]; then
				STATUS="installed"
			else
				STATUS="not installed"
			fi

			REL_DIR=$(dirname "${RECIPE_FILE#$RECIPE_DIR/}")
			if [ "$REL_DIR" != "." ]; then
				CATEGORY=" [$REL_DIR]"
			else
				CATEGORY=""
			fi

			if [ -n "$PKG_VERSION" ]; then
				echo "$PKG_NAME ($PKG_VERSION) - $STATUS$CATEGORY"
			else
				echo "$PKG_NAME - $STATUS$CATEGORY"
			fi
		done < <(find "$RECIPE_DIR" -type f -name "*.sh" | sort)
		;;
	wares)
		echo "Packages installed on system:"
		mkdir -p "$LOG_DIR"
		for MANIFEST_FILE in "$LOG_DIR"/*.files; do
			[ -e "$MANIFEST_FILE" ] || continue
			PKG_NAME=$(basename "$MANIFEST_FILE" .files)
			PKG_VERSION=$(head -n1 "$MANIFEST_FILE" | sed -n 's/^#VERSION=//p')
			if [ -n "$PKG_VERSION" ]; then
				echo "	$PKG_NAME ($PKG_VERSION)"
			else
				echo "	$PKG_NAME"
			fi
		done
		;;
	gauge)
		if [ -z "$PACKAGE" ]; then
			echo "Error: Specify the package to gauge, e.g. 'forge gauge foo'"
			exit 1
		fi

		RECIPE=$(resolve_recipe "$PACKAGE")
		RESOLVE_STATUS=$?

		if [ "$RESOLVE_STATUS" -eq 2 ]; then
			exit 1
		elif [ "$RESOLVE_STATUS" -ne 0 ] || [ ! -f "$RECIPE" ]; then
			echo "Error: Recipe for '$PACKAGE' not found"
			exit 1
		fi

		OPTIONS=()
		source "$RECIPE"

		NAME="${NAME%$'\r'}"
		VERSION="${VERSION%$'\r'}"
		URL="${URL%$'\r'}"
		SHA256SUM="${SHA256SUM%$'\r'}"
		MD5SUM="${MD5SUM%$'\r'}"

		CHECKSUM_SOURCE=""
		if [ -f "${CHECKSUM_DIR}/${NAME}.sha256sum" ] || [ -f "${CHECKSUM_DIR}/${NAME}.md5sum" ]; then
			CHECKSUM_SOURCE=" (from $CHECKSUM_DIR)"
		fi
		load_external_checksum "$NAME"

		echo "Details of Package: $NAME"
		echo "==============================="
		echo "Version: $VERSION"
		echo "URL: $URL"
		if [ -n "$SHA256SUM" ]; then
			echo "SHA256: ${SHA256SUM}${CHECKSUM_SOURCE}"
		elif [ -n "$MD5SUM" ]; then
			echo "MD5: ${MD5SUM}${CHECKSUM_SOURCE}"
		else
			echo "Checksum: Not defined (checksum verification will be skipped)"
		fi
		echo "Description: ${DESCRIPTION:-No description provided.}"
		if declare -p OPTIONS >/dev/null 2>&1 && [ ${#OPTIONS[@]} -gt 0 ]; then
			echo "Options:"
			for GOPT_ENTRY in "${OPTIONS[@]}"; do
				GOPT_ENTRY="${GOPT_ENTRY%$'\r'}"
				GOPT_KEY="${GOPT_ENTRY%%:*}"
				GOPT_REST="${GOPT_ENTRY#*:}"
				GOPT_DESC="${GOPT_REST%%:*}"
				GOPT_DEFAULT="${GOPT_REST##*:}"
				[ "$GOPT_DEFAULT" = "y" ] || GOPT_DEFAULT="n"
				echo "  --with-${GOPT_KEY} / --without-${GOPT_KEY} (default: ${GOPT_DEFAULT}) -- ${GOPT_DESC}"
			done
		fi
		if [ -d "${REPO_DIR}/${NAME}/${VERSION}" ]; then
			GOPT_CACHED=$(find "${REPO_DIR}/${NAME}/${VERSION}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
			echo "Repo cache: ${GOPT_CACHED} pre-built config(s) for ${VERSION} (forge repo list ${NAME})"
		fi
		echo "==============================="
		;;
	repo)
		REPO_SUB="$PACKAGE"
		REPO_ARG="$3"
		case "$REPO_SUB" in
			init)
				repo_ensure
				echo "Repo pronto em $REPO_DIR${REPO_REMOTE:+ (remote: $REPO_REMOTE)}"
				;;
			pull)
				repo_ensure
				if ! git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1; then
					echo "Error: nenhum remote configurado (defina REPO_REMOTE em forge.conf)."
					exit 1
				fi
				git -C "$REPO_DIR" pull --ff-only origin HEAD
				;;
			push)
				repo_ensure
				if ! git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1; then
					echo "Error: nenhum remote configurado (defina REPO_REMOTE em forge.conf)."
					exit 1
				fi
				git -C "$REPO_DIR" push origin HEAD
				;;
			status)
				repo_ensure
				echo "Repo path: $REPO_DIR"
				if git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1; then
					echo "Remote: $(git -C "$REPO_DIR" remote get-url origin)"
				else
					echo "Remote: (nenhum configurado)"
				fi
				if [ "$REPO_AUTO_PUSH" -eq 1 ]; then
					echo "Auto-push: habilitado"
				else
					echo "Auto-push: desabilitado"
				fi
				git -C "$REPO_DIR" status -s
				;;
			list)
				repo_ensure
				if [ -n "$REPO_ARG" ]; then
					find "$REPO_DIR/$REPO_ARG" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | sort | while read -r RLD; do
						RL_VER=$(basename "$(dirname "$RLD")")
						RL_CFG=$(basename "$RLD")
						RL_OPTS=""
						[ -f "$RLD/info" ] && RL_OPTS=$(sed -n 's/^OPTIONS=//p' "$RLD/info")
						echo "${REPO_ARG} ${RL_VER} (${RL_CFG})${RL_OPTS:+ [$RL_OPTS]}"
					done
				else
					find "$REPO_DIR" -mindepth 3 -maxdepth 3 -type d 2>/dev/null | sort | while read -r RLD; do
						RL_CFG=$(basename "$RLD")
						RL_VER=$(basename "$(dirname "$RLD")")
						RL_NAME=$(basename "$(dirname "$(dirname "$RLD")")")
						RL_OPTS=""
						[ -f "$RLD/info" ] && RL_OPTS=$(sed -n 's/^OPTIONS=//p' "$RLD/info")
						echo "${RL_NAME} ${RL_VER} (${RL_CFG})${RL_OPTS:+ [$RL_OPTS]}"
					done
				fi
				;;
			*)
				echo "Usage: forge repo <init|pull|push|status|list> [pkg]"
				exit 1
				;;
		esac
		;;
	menu)
		if ! command -v whiptail > /dev/null 2>&1; then
			if command -v dialog > /dev/null 2>&1; then
				# Termux (and some other environments) only package
				# dialog, not whiptail -- shim it in, since the two
				# share most basic option syntax. --scrolltext is
				# whiptail-only, so it's the one thing filtered out.
				whiptail() {
					local args=() a
					for a in "$@"; do
						[ "$a" = "--scrolltext" ] && continue
						args+=("$a")
					done
					dialog "${args[@]}"
				}
			else
				echo "Error: neither 'whiptail' nor 'dialog' found. Install one (the 'newt'/'whiptail' package in BLFS, or 'dialog' on Termux) to use 'forge menu'."
				exit 1
			fi
		fi

		while true; do
			MENU_CHOICE=$(whiptail --title "Forge" --backtitle "LFS Package Manager" \
				--menu "What would you like to do?" 16 60 4 \
				"1" "Browse recipes" \
				"2" "Installed packages" \
				"3" "Check for updates" \
				"4" "Exit" \
				3>&1 1>&2 2>&3)
			[ $? -ne 0 ] && break

			case "$MENU_CHOICE" in
				1) menu_browse_recipes ;;
				2) menu_browse_installed ;;
				3) menu_check_updates ;;
				4) break ;;
			esac
		done
		clear
		;;
	*)
		echo "Usage: forge [smith|assay|probe|sketch|temper|melt|gauge|repo|orphans|search] [package name]"
		echo "       forge [patts|wares|menu]"
		echo "Run 'forge help' for details on each command and flag."
		exit 1
		;;
esac
